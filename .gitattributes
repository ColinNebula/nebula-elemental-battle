# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Config files
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.npmrc text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary

# Audio files
*.mp3 binary
*.wav binary
*.ogg binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ==============================================
# Git LFS Configuration (Optional - Commented Out)
# ==============================================
# To enable Git LFS for large audio files:
# 1. Install Git LFS: https://git-lfs.github.com/
# 2. Run: git lfs install
# 3. Uncomment the lines below
# 4. Run: git lfs migrate import --include="*.mp3" --everything
#
# Large MP3 files (>10MB) - Total: 103MB
# *.mp3 filter=lfs diff=lfs merge=lfs -text
# public/Burnt_Out_Space_Hulk.mp3 filter=lfs diff=lfs merge=lfs -text
# public/Battle_of_the_Pixelated_Cyborgs.mp3 filter=lfs diff=lfs merge=lfs -text
# public/When_You_Risk_it_All.mp3 filter=lfs diff=lfs merge=lfs -text
# public/Sunrise_in_Megalopolis.mp3 filter=lfs diff=lfs merge=lfs -text

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Exclude from GitHub language stats
*.md linguist-documentation
*.txt linguist-documentation
LICENSE linguist-documentation
docs/* linguist-documentation

# Mark server files as optional
*-server.js linguist-vendored
server-proxy.js linguist-vendored

# Mark generated files
build/* linguist-generated
*.map linguist-generated
